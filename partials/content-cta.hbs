{{{html}}}
<aside class="gh-post-upgrade-cta">
  <div class="gh-post-upgrade-cta-content" style="background-color: {{@site.accent_color}}">
    {{#has visibility="paid"}}
      <h2 style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;">This post is for paying members only</h2>
    {{/has}}
    {{#has visibility="members"}}
    <h2 style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif; font-size: 32px;">Keep reading with your email — it’s free</h2>
<p style="font-size: 18px;">Create a free account to read more articles each month, and get the best of Hyperallergic in your inbox.</p>
    {{/has}}
    {{#if @member}}
      <a class="gh-btn" data-portal="account/plans" style="color:{{@site.accent_color}}">Upgrade your account</a>
    {{else}}
      <a class="gh-btn" data-portal="signup" style="color:{{@site.accent_color}}">Create free account</a>
      <p><small>Already have an account? <a data-portal="signin">Sign in</a></small></p>
    {{/if}}
  </div>
</aside>
